---
title: "Sid Menon"
description: "Sid Menon writes about technology, design, culture, and learning to think for himself."
date: 2026-08-16
autotagging: false
---
<script lang="ts">
	import { resolve } from '$app/paths';
	import { onMount } from 'svelte';
	import type { PageData } from './$types';

	let { data }: { data: PageData } = $props();
	let subscriptionState = $state<'idle' | 'submitting' | 'pending' | 'confirmed' | 'error'>(
		'idle'
	);
	let subscriptionMessage = $state('');

	onMount(() => {
		const status = new URL(window.location.href).searchParams.get('subscription');
		if (status === 'confirmed') {
			subscriptionState = 'confirmed';
			subscriptionMessage = "You're subscribed. The next essay will arrive by email.";
		} else if (status === 'invalid') {
			subscriptionState = 'error';
			subscriptionMessage = 'That confirmation link is invalid or expired. Try subscribing again.';
		} else if (status === 'error') {
			subscriptionState = 'error';
			subscriptionMessage = 'Something went wrong while confirming. Try again in a moment.';
		}
	});

	async function subscribe(event: SubmitEvent) {
		event.preventDefault();
		const form = event.currentTarget as HTMLFormElement;
		subscriptionState = 'submitting';
		subscriptionMessage = '';

		try {
			const response = await fetch(form.action, {
				method: 'POST',
				body: new FormData(form),
				headers: { Accept: 'application/json' }
			});
			const result = (await response.json()) as { message?: string };

			if (!response.ok) throw new Error(result.message || 'Unable to subscribe right now.');

			form.reset();
			subscriptionState = 'pending';
			subscriptionMessage = result.message || 'Check your inbox to confirm your subscription.';
		} catch (error) {
			subscriptionState = 'error';
			subscriptionMessage =
				error instanceof Error ? error.message : 'Unable to subscribe right now.';
		}
	}

	function dateParts(date: string) {
		const parsed = new Date(date);
		const year = String(parsed.getUTCFullYear());
		const month = String(parsed.getUTCMonth() + 1).padStart(2, '0');
		const day = String(parsed.getUTCDate()).padStart(2, '0');
		return { year, compact: `${month} / ${day}` };
	}
</script>

<div class="home-page">
	<main class="home-main">
		<header class="identity-row">
			<h1>Sid Menon</h1>
			<a href={resolve('/about')}>ABOUT →</a>
		</header>

		<div class="bio">
			<p>My name is Sidharth (Sid) Menon.</p>
			<p>I am currently based out of San Francisco and am interested in the intersection of technology, design, and culture.</p>
			<p>I grew up in Ohio and studied at Harvard.</p>
		</div>

		<section class="writing" aria-labelledby="writing-heading">
			<h2 id="writing-heading">WRITING</h2>
			<div class="post-list">
				{#each data.posts as post, index (post.slug)}
					{@const date = dateParts(post.date)}
					<!-- eslint-disable-next-line svelte/no-navigation-without-resolve -->
					<a class="post-row" href="/posts/{post.slug}" aria-label="Read {post.title}">
						<span class="year">{index === 0 || dateParts(data.posts[index - 1].date).year !== date.year ? date.year : ''}</span>
						<div class="post-copy">
							<span class="post-title">{post.title}</span>
							<p>{post.description}</p>
						</div>
						<span class="leader" aria-hidden="true"></span>
						<time class="post-date" datetime={post.date}>{date.compact}</time>
					</a>
				{/each}
			</div>
		</section>
	</main>

	<section class="subscribe" aria-labelledby="subscribe-heading">
		<div class="subscribe-meta">
			<h2 id="subscribe-heading">NEW ESSAYS</h2>
			<a href={resolve('/rss.xml')}>rss</a>
		</div>
		<div class="subscribe-action">
			{#if subscriptionState === 'pending' || subscriptionState === 'confirmed'}
				<p class="subscribe-status" aria-live="polite">{subscriptionMessage}</p>
			{:else}
				<form class="subscribe-form" method="post" action="/api/subscribe" onsubmit={subscribe}>
					<label class="sr-only" for="subscribe-email">Email address</label>
					<input
						id="subscribe-email"
						name="email"
						type="email"
						autocomplete="email"
						placeholder="you@example.com"
						required
					/>
					<label class="website-field" aria-hidden="true">
						Website
						<input name="website" type="text" tabindex="-1" autocomplete="off" />
					</label>
					<button type="submit" disabled={subscriptionState === 'submitting'}>
						{subscriptionState === 'submitting' ? 'sending…' : 'subscribe →'}
					</button>
				</form>
				{#if subscriptionState === 'error'}
					<p class="subscribe-error" aria-live="polite">{subscriptionMessage}</p>
				{/if}
			{/if}
		</div>
	</section>

	<footer class="site-footer">
		<p>I have had my invitation to this world's festival, and thus my life has been blessed. - Tagore</p>
		<nav aria-label="External links">
			<!-- eslint-disable-next-line svelte/no-navigation-without-resolve -->
			<a href="https://www.linkedin.com/in/sidkmenon/">LinkedIn</a>
			<span aria-hidden="true">·</span>
			<a href="mailto:menon.sid.k@gmail.com">Email</a>
			<span aria-hidden="true">·</span>
			<!-- eslint-disable-next-line svelte/no-navigation-without-resolve -->
			<a href="https://dev.fast">/dev/fast</a>
		</nav>
	</footer>
</div>

<style>
