		--home-content-width: min(100%, clamp(680px, 64vw, 960px));
		display: flex;
		flex-direction: column;
		width: min(calc(100% - 240px), 1200px);
		min-height: 100svh;
		margin: 0 auto;
		padding: 64px 0 48px;
	}

	.home-main {
		width: var(--home-content-width);
	}

