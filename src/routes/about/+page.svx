						<span class="category">{blog.showCategory ? blog.category : ''}</span>
						<div class="blog-name-line">
							<span class="blog-name">{blog.name}</span>
						</div>
						<p>{blog.description}</p>
					</a>
				{/each}
			</div>
		</section>
	</main>

