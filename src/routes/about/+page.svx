			category: 'Design',
			showCategory: true,
			name: "Maggie Appleton's blog",
			description: 'digital gardening, anthropology, and generally brilliant!',
			href: 'https://maggieappleton.com/'
		},
		{
			category: 'Design',
			showCategory: false,
			name: 'Ketan Agrawal',
			description: 'lovely vignettes on design, tech, philosophy. A gem!',
